generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Permission {
  CLIENTE_BUSCAR
  CLIENTE_CADASTRAR
  DSF_EMITIR
  DSF_CANCELAR
  ANVISA_RELATORIOS
  DRIVE_CONFIGURAR
  TEMPERATURA_GERENCIAR
  EQUIPAMENTOS_GERENCIAR
  POPS_GERENCIAR
  VALIDADE_GERENCIAR
  PAINEL_FISCAL_GERENCIAR
  FRACIONAMENTO_GERENCIAR
  SUPER_ADMIN_GLOBAIS
}

enum DsfStatus {
  EMITIDA
  CONCLUIDA
  CANCELADA
}

enum TipoImpressao {
  BOBINA_80MM
  FOLHA_A4
}

enum TipoServico {
  AFERICAO_PRESSAO_ARTERIAL
  AFERICAO_TEMPERATURA
  GLICEMIA_CAPILAR
  TESTE_RAPIDO_COVID19
  TESTE_RAPIDO_DENGUE
  TESTE_RAPIDO_INFLUENZA
  TESTE_RAPIDO_BETA_HCG
  TESTE_RAPIDO_PERFIL_LIPIDICO
  ADMINISTRACAO_INJETAVEIS
  INALACAO_NEBULIZACAO
  PERFURACAO_LOBULO
}

enum AuditAcao {
  LOGIN
  LOGOUT
  CLIENTE_CRIADO
  CLIENTE_ATUALIZADO
  DSF_CRIADA
  DSF_CONCLUIDA
  DSF_CANCELADA
  DSF_VISUALIZADA
  DRIVE_AUTORIZADO
  DRIVE_REVOGADO
  USUARIO_CRIADO
  USUARIO_ATUALIZADO
  TENANT_CRIADO
  TENANT_ATUALIZADO
  CRON_CLEANUP_DSF
  ASSINATURA_CRIADA
  ASSINATURA_ATUALIZADA
  ASSINATURA_CANCELADA
  ASSINATURA_EXPIRADA
  PAGAMENTO_REGISTRADO
  PLANO_CRIADO
  PLANO_ATUALIZADO
  AMBIENTE_CRIADO
  AMBIENTE_ATUALIZADO
  TEMPERATURA_REGISTRADA
  CRON_ALERTAS_TEMPERATURA
  EQUIPAMENTO_CRIADO
  EQUIPAMENTO_ATUALIZADO
  CRON_ALERTAS_EQUIPAMENTOS
  POP_CONCLUIDO
  POP_REPROVADO
  POP_CRIADO
  POP_ATUALIZADO
  LOTE_CRIADO
  LOTE_ATUALIZADO
  LOTE_QUARENTENA
  LOTE_DESCARTADO
  CRON_ALERTAS_VALIDADE
  TOKEN_FISCAL_GERADO
  TOKEN_FISCAL_ABERTO
  TOKEN_FISCAL_REENVIADO
  FRACAO_CRIADA
  FRACAO_ATUALIZADA
  ETIQUETA_IMPRESSA
}

enum TipoPlano {
  TRIAL
  MENSAL
  ANUAL
  VITALICIO
}

enum StatusAssinatura {
  TRIAL
  ATIVA
  SUSPENSA
  CANCELADA
  EXPIRADA
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  REEMBOLSADO
  ESTORNADO
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Tenant {
  id              String   @id @default(uuid())
  nomeFantasia    String
  razaoSocial     String
  cnpj            String   @unique
  endereco        String
  telefone        String
  alvaraSanitario String
  logoUrl         String?
  tipoImpressao   TipoImpressao @default(BOBINA_80MM)
  ativo              Boolean  @default(true)
  modulosHabilitados String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users                User[]
  clientes             Cliente[]
  dsfs                 DSF[]
  driveCredential      DriveCredential?
  auditLogs            AuditLog[]
  procedimentoConfigs  ProcedimentoConfig[]
  assinatura           Assinatura?
  ambientes            Ambiente[]
  equipamentos         Equipamento[]
  documentosPOP        DocumentoPOP[]
  assinaturasPOP       AssinaturaPOP[]
  produtosCatalogo     ProdutoCatalogo[]
  lotesProduto         LoteProduto[]
  autoDescartes        AutoDescarte[]
  tokensFiscal         TokenFiscal[]
  fracionamentos       FracionamentoLote[]
  fracoesItens         FracaoItem[]
  diasFechados         DiaFechado[]
  historicoCalibracoes HistoricoCalibracao[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  nome      String
  email     String
  senhaHash   String
  permissions Permission[] @default([CLIENTE_BUSCAR, DSF_EMITIR])
  crf         String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  dsfsComoRT        DSF[]         @relation("ResponsavelTecnico")
  dsfsComoAtendente DSF[]         @relation("Atendente")
  auditLogs         AuditLog[]
  assinaturasPOP    AssinaturaPOP[]
  registrosTemp        RegistroTermoHigrometria[]
  diasFechados         DiaFechado[]
  historicoCalibracoes HistoricoCalibracao[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Cliente {
  id                  String   @id @default(uuid())
  tenantId            String
  nome                String
  cpf                 String
  rg                  String?
  dataNascimento      DateTime @db.Date
  sexo                String
  telefone            String
  email               String?
  endereco            String
  consentimentoLgpdAt DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  dsfs   DSF[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
}

model DSF {
  id                   String      @id @default(uuid())
  tenantId             String
  numeroDsf            String
  clienteId            String
  responsavelTecnicoId String
  atendenteId          String
  tipoServico          TipoServico
  dataEmissao          DateTime    @default(now())
  observacoes          String?
  status               DsfStatus   @default(EMITIDA)
  driveFileId          String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant             Tenant      @relation(fields: [tenantId], references: [id])
  cliente            Cliente     @relation(fields: [clienteId], references: [id])
  responsavelTecnico User        @relation("ResponsavelTecnico", fields: [responsavelTecnicoId], references: [id])
  atendente          User        @relation("Atendente", fields: [atendenteId], references: [id])
  insumos            InsumoDSF[]

  @@unique([tenantId, numeroDsf])
  @@index([tenantId])
  @@index([tenantId, dataEmissao(sort: Desc)])  // relatório de fiscalização
  @@index([clienteId])
  @@index([status, updatedAt])                  // cron cleanup
}

model InsumoDSF {
  id          String   @id @default(uuid())
  dsfId       String
  nomeProduto String
  lote        String
  fabricante  String
  validade    DateTime @db.Date
  quantidade  Decimal  @db.Decimal(10, 3)
  unidade     String

  dsf DSF @relation(fields: [dsfId], references: [id])

  @@index([dsfId])
}

model DriveCredential {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  accessToken   String   // criptografado AES-256-GCM
  refreshToken  String   // criptografado AES-256-GCM
  tokenExpiry   DateTime
  driveFolderId String
  driveEmail    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model AuditLog {
  id          String    @id @default(uuid())
  tenantId    String?   // null para ações de sistema (ex: cron)
  userId      String?   // null para ações de sistema
  acao        AuditAcao
  recursoTipo String
  recursoId   String
  ip          String
  userAgent   String
  createdAt   DateTime  @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])  // painel de auditoria paginado
  @@index([tenantId])
}

model ProcedimentoConfig {
  id               String      @id @default(uuid())
  tenantId         String
  tipoServico      TipoServico
  ativo            Boolean     @default(true)
  textoOrientacao  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, tipoServico])
  @@index([tenantId])
}

model Plano {
  id               String    @id @default(uuid())
  nome             String
  descricao        String?
  tipo             TipoPlano
  precoMensal      Int?      // em centavos (null = gratuito/vitalício sem cobrança recorrente)
  precoAnual       Int?      // em centavos (null = não aplicável)
  limiteUsuarios   Int?      // null = ilimitado
  limiteDsfsMes    Int?      // null = ilimitado
  trialDias            Int?      // apenas para tipo TRIAL
  ativo                Boolean   @default(true)
  stripeMonthlyPriceId String?   // Stripe Price ID para cobrança mensal
  stripeAnnualPriceId  String?   // Stripe Price ID para cobrança anual
  stripeOnetimePriceId String?   // Stripe Price ID para pagamento único (vitalício)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  assinaturas Assinatura[]
}

model GatewayConfig {
  id                     String   @id @default(uuid())
  gateway                String   @unique  // "stripe" | "asaas" | "mercadopago"
  label                  String
  secretKeyEncrypted     String?
  webhookSecretEncrypted String?
  publicKey              String?
  ativo                  Boolean  @default(false)
  modoTeste              Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Assinatura {
  id                    String           @id @default(uuid())
  tenantId              String           @unique
  planoId               String
  status                StatusAssinatura @default(TRIAL)
  inicioEm              DateTime         @default(now())
  expiraEm              DateTime?        // null = vitalício
  trialExpiraEm         DateTime?
  canceladaEm           DateTime?
  motivoCancelamento    String?
  gateway               String?          // "stripe" | "asaas" | "mercadopago" | null
  gatewayCustomerId     String?
  gatewaySubscriptionId String?
  obs                   String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  plano        Plano          @relation(fields: [planoId], references: [id])
  pagamentos   PagamentoLog[]

  @@index([status, expiraEm])  // cron de expiração
}

model PagamentoLog {
  id               String         @id @default(uuid())
  assinaturaId     String
  tenantId         String
  valor            Int            // em centavos
  moeda            String         @default("BRL")
  status           StatusPagamento
  gateway          String
  gatewayPaymentId String?
  descricao        String?
  metadados        Json?          // payload bruto do webhook
  createdAt        DateTime       @default(now())

  assinatura Assinatura @relation(fields: [assinaturaId], references: [id])

  @@index([assinaturaId])
  @@index([tenantId, createdAt(sort: Desc)])
}

model Ambiente {
  id         String   @id @default(uuid())
  tenantId   String
  nome       String
  tipo       String   // "GELADEIRA" | "AMBIENTE" | "SALA_ESPECIAL"
  tempMin    Float
  tempMax    Float
  umidadeMin Float?
  umidadeMax Float?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  registros RegistroTermoHigrometria[]
  tenant    Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Equipamento {
  id                    String   @id @default(uuid())
  tenantId              String
  nome                  String
  marcaModelo           String
  numeroSerie           String?
  dataUltimaCalibracao  DateTime @db.Date
  dataProximaCalibracao DateTime @db.Date
  status                String   @default("ATIVO") // "ATIVO" | "VENCENDO" | "VENCIDO" | "MANUTENCAO"
  laudoDriveFileId      String?
  laudoUrl              String?
  numeroCertificado     String?
  laboratorio           String?
  fotoFileId            String?
  fotoUrl               String?
  obs                   String?
  ativo                 Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  historico HistoricoCalibracao[]

  @@index([tenantId])
  @@index([dataProximaCalibracao])
}

model HistoricoCalibracao {
  id               String   @id @default(uuid())
  tenantId         String
  equipamentoId    String
  usuarioId        String
  dataCalib        DateTime @db.Date
  dataProxima      DateTime @db.Date
  numeroCertificado String?
  laboratorio      String?
  laudoFileId      String?
  laudoUrl         String?
  obs              String?
  createdAt        DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id])
  usuario     User        @relation(fields: [usuarioId], references: [id])

  @@index([tenantId])
  @@index([equipamentoId])
}

model RegistroTermoHigrometria {
  id               String   @id @default(uuid())
  ambienteId       String
  tenantId         String
  dataLeitura      DateTime @db.Date
  periodo          String   // "MANHA" | "TARDE"
  temperaturaGraus Float
  umidadePercent   Float?
  usuarioId        String
  alertaDisparado  Boolean  @default(false)
  observacao       String?
  createdAt        DateTime @default(now())

  fotoFileId String?
  fotoUrl    String?

  ambiente Ambiente @relation(fields: [ambienteId], references: [id])
  usuario  User     @relation(fields: [usuarioId], references: [id])

  @@unique([ambienteId, dataLeitura, periodo])
  @@index([tenantId, dataLeitura(sort: Desc)])
}

model DiaFechado {
  id        String   @id @default(uuid())
  tenantId  String
  data      DateTime @db.Date
  motivo    String?
  usuarioId String
  createdAt DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  usuario User   @relation(fields: [usuarioId], references: [id])

  @@unique([tenantId, data])
  @@index([tenantId])
}

// ─── Módulo 2.1 — POPs e E-learning ─────────────────────────────────────────

model DocumentoPOP {
  id         String   @id @default(uuid())
  tenantId   String?  // null = conteúdo padrão FarmaSign (global)
  codigo     String   // "POP-01"
  titulo     String
  baseLegal  String?
  objetivo   String?
  conteudo   String   // texto com seções separadas por "### Título\n\n"
  versao     String   @default("1.0")
  minAcertos Int      @default(2)
  vigente    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant?        @relation(fields: [tenantId], references: [id])
  questoes    QuestaoQuiz[]
  assinaturas AssinaturaPOP[]

  @@index([tenantId])
  @@index([codigo])
}

model QuestaoQuiz {
  id              String  @id @default(uuid())
  documentoId     String
  ordem           Int
  enunciado       String
  opcoes          Json    // [{letra:"a",texto:"..."},{...}]
  respostaCorreta String  // "a" | "b" | "c" | "d"
  justificativa   String?

  documento DocumentoPOP @relation(fields: [documentoId], references: [id])

  @@index([documentoId])
}

model AssinaturaPOP {
  id            String   @id @default(uuid())
  documentoId   String
  tenantId      String
  usuarioId     String
  acertos       Int
  totalQuestoes Int
  aprovado      Boolean
  respostas     Json     // {questaoId: "a"}
  ipOrigem      String
  userAgent     String
  termoAceito   Boolean  @default(false)
  termoAceitoEm DateTime?
  createdAt     DateTime @default(now())

  documento DocumentoPOP @relation(fields: [documentoId], references: [id])
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  usuario   User         @relation(fields: [usuarioId], references: [id])

  @@index([documentoId, usuarioId])
  @@index([tenantId])
}

// ─── Módulo 3.1 — Controle de Validade e Quarentena ─────────────────────────

model ProdutoCatalogo {
  id            String   @id @default(uuid())
  tenantId      String
  nome          String
  fabricante    String?
  unidadePadrao String   @default("un")
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  lotes  LoteProduto[]
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, nome])
  @@index([tenantId])
}

model LoteProduto {
  id                 String   @id @default(uuid())
  tenantId           String
  produtoCatalogoId  String
  fabricante         String
  lote               String
  validade           DateTime @db.Date
  quantidade         Decimal  @db.Decimal(10, 3)
  unidade            String   @default("un") // "un"|"cx"|"mL"|"g"|"mg"|"L"|"kg"
  status             String   @default("ATIVO") // "ATIVO"|"QUARENTENA"|"DESCARTADO"
  localizacao        String?
  obs                String?
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  produto        ProdutoCatalogo     @relation(fields: [produtoCatalogoId], references: [id])
  descarte       AutoDescarte?
  fracionamentos FracionamentoLote[]

  @@index([tenantId])
  @@index([validade])
  @@index([tenantId, status])
}

model AutoDescarte {
  id           String   @id @default(uuid())
  loteId       String   @unique
  tenantId     String
  usuarioId    String
  numeroAuto   String
  motivo       String
  dataDescarte DateTime @db.Date
  responsavel  String
  obs          String?
  createdAt    DateTime @default(now())

  lote   LoteProduto @relation(fields: [loteId], references: [id])
  tenant Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ─── Módulo 2.2 — Painel do Fiscal ──────────────────────────────────────────

model TokenFiscal {
  id         String    @id @default(uuid())
  tenantId   String
  usuarioId  String
  token      String    @unique @default(uuid())
  secoes     String[]  // ["TEMPERATURA","EQUIPAMENTOS","POPS","VALIDADE"]
  dataInicio DateTime  @db.Date
  dataFim    DateTime  @db.Date
  expiraEm   DateTime  // createdAt + 30 min
  usadoEm    DateTime? // set na primeira visualizacao (expira imediatamente apos)
  createdAt  DateTime  @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  logs   TokenFiscalLog[]

  @@index([tenantId])
  @@index([token])
}

model TokenFiscalLog {
  id        String   @id @default(uuid())
  tokenId   String
  evento    String   // "GERADO" | "ABERTO" | "REENVIADO"
  ip        String
  userAgent String
  createdAt DateTime @default(now())

  token TokenFiscal @relation(fields: [tokenId], references: [id])

  @@index([tokenId])
}

// ─── Módulo 3.2 — Rastreabilidade de Fracionamento ───────────────────────────

model FracionamentoLote {
  id                   String   @id @default(uuid())
  tenantId             String
  loteId               String
  usuarioId            String
  dataFracionamento    DateTime @default(now())
  quantidadeFracionada Decimal  @db.Decimal(10, 3)
  unidadeOrigem        String
  totalFracoes         Int
  obs                  String?
  createdAt            DateTime @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  lote    LoteProduto @relation(fields: [loteId], references: [id])
  fracoes FracaoItem[]

  @@index([tenantId])
  @@index([loteId])
}

model FracaoItem {
  id                 String    @id @default(uuid())
  tenantId           String
  fracionamentoId    String
  numero             Int
  quantidade         Decimal   @db.Decimal(10, 3)
  unidade            String
  destinacao         String?
  etiquetaImpressaEm DateTime?
  createdAt          DateTime  @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  fracionamento FracionamentoLote @relation(fields: [fracionamentoId], references: [id])

  @@index([tenantId])
  @@index([fracionamentoId])
}
